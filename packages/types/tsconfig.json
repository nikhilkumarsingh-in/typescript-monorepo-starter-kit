{
    "extends": "../../tsconfig.base.json",

    "compilerOptions": {
        "module": "nodenext",
        "moduleDetection": "force",
        "moduleResolution": "nodenext",
        "rewriteRelativeImportExtensions": true,
        "target": "esnext",

        "types": ["node"]
    },

    "include": ["./src"],
    "exclude": ["./node_modules", "./dist"]
}
