{
    "name": "typescript-monorepo-starter-kit",
    "private": true,
    "version": "1.0.0",
    "description": "TypeScript monorepo starter kit for full stack application.",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "license": "MIT",
    "author": "Nikhil Kumar Singh <nikhilkumarsingh.in@gmail.com>",
    "type": "module",
    "scripts": {
        "dev:backend": "npm run dev --workspace=@repo/backend",
        "start:backend": "npm start --workspace=@repo/backend",
        "build": "tsc -b",
        "clean:build": "tsc -b --clean",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
